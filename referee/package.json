{
  "name": "botbet-referee",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json",
    "play-game": "node scripts/check-setup.mjs --quiet && tsx src/play-game.ts",
    "settle": "node scripts/check-setup.mjs --quiet && tsx src/settle.ts",
    "cap-demo": "node scripts/check-setup.mjs --quiet && tsx src/cap-demo.ts",
    "check-setup": "node scripts/check-setup.mjs",
    "play-poker": "node scripts/check-setup.mjs --quiet && tsx src/poker/play-poker.ts",
    "settle-poker": "node scripts/check-setup.mjs --quiet && tsx src/poker/settle-poker.ts",
    "rehearse:local": "node scripts/check-setup.mjs --quiet && tsx scripts/local-rehearsal.ts",
    "demo": "node scripts/check-setup.mjs --quiet && tsx src/presenter.ts",
    "replay-last": "tsx src/replay-last.ts",
    "register-bot": "tsx src/registry/register-bot.ts",
    "test": "node scripts/run-tests.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "botbet-shared": "file:../shared",
    "chess.js": "^1.4.0",
    "stockfish": "^19.0.1",
    "viem": "^2.58.2"
  }
}
