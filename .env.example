# BotBet — environment template.
# Copy to .env and fill in. NEVER commit .env. Testnet burner wallets only.
#   cp .env.example .env
# Each person keeps their own .env and their own burner keys.

# ----------------------------------------------------------------------------
# Arc testnet
# ----------------------------------------------------------------------------
ARC_RPC_URL=
ARC_CHAIN_ID=
ARC_EXPLORER_URL=
# ERC-20 USDC on Arc testnet. We use the 6-decimal ERC-20 interface everywhere,
# never native 18-decimal amounts. See interfaces.md.
USDC_ADDRESS=

# ----------------------------------------------------------------------------
# Keys — TESTNET BURNERS ONLY, never a wallet with real funds
# ----------------------------------------------------------------------------
DEPLOYER_PRIVATE_KEY=
REFEREE_PRIVATE_KEY=
# Public address matching REFEREE_PRIVATE_KEY; bots pay intel fees to it.
REFEREE_ADDRESS=
BOT_1_PRIVATE_KEY=
BOT_2_PRIVATE_KEY=
BOT_3_PRIVATE_KEY=
BOT_4_PRIVATE_KEY=

# ----------------------------------------------------------------------------
# Deployed contracts — mirrors shared/deployments.json, written by the deploy
# script. Fill these only if you need to override what's in that file.
# ----------------------------------------------------------------------------
AGENT_WALLET_ADDRESS=
MATCH_ESCROW_ADDRESS=
BET_POOL_ADDRESS=

# ----------------------------------------------------------------------------
# Services
# ----------------------------------------------------------------------------
# ElevenLabs — commentator text-to-speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# QuickNode — Streams webhook feeding live odds and the leaderboard
QUICKNODE_RPC_URL=
QUICKNODE_API_KEY=
QUICKNODE_WEBHOOK_SECRET=

# Claude API — writes the commentator's one-liners
ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
# Local processes
# ----------------------------------------------------------------------------
REFEREE_PORT=8080
# Bearer token for the referee's write routes (POST /api/matches). Any random string.
ADMIN_TOKEN=
# Absolute path to the Stockfish binary used by the referee and bots.
STOCKFISH_PATH=

# Paid intel (interfaces.md section 5). Price is USDC base units: 500000 = 0.50 USDC.
INTEL_PRICE_USDC=500000
INTEL_MIN_CONFIRMATIONS=1

# Browser-visible config. Vite only exposes variables prefixed with VITE_,
# so anything secret must NOT start with VITE_.
VITE_REFEREE_HTTP_URL=http://localhost:8080
VITE_REFEREE_WS_URL=ws://localhost:8080
